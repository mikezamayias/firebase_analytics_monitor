diff --git a/lib/src/utils/event_filter_utils.dart b/lib/src/utils/event_filter_utils.dart
index 870db19..fe38f5e 100644
--- a/lib/src/utils/event_filter_utils.dart
+++ b/lib/src/utils/event_filter_utils.dart
@@ -3,6 +3,43 @@ class EventFilterUtils {
   // Private constructor to prevent instantiation
   EventFilterUtils._();
 
+  /// Expands a list of values that may contain comma-separated entries.
+  ///
+  /// Each value is split on commas, trimmed, and empty segments are discarded.
+  /// This allows flags like `-s event1,event2` in addition to repeated flags.
+  static List<String> expandCommaSeparated(List<String> values) {
+    if (values.isEmpty) return values;
+    return values
+        .expand((v) => v.split(','))
+        .map((v) => v.trim())
+        .where((v) => v.isNotEmpty)
+        .toList();
+  }
+
+  /// Check if an event should be skipped based on required parameter names.
+  ///
+  /// Returns true if the event should be skipped (none of the required
+  /// parameter names are present in the event's parameters or items).
+  ///
+  /// Multiple [requiredParamNames] combine with OR logic: the event passes
+  /// if ANY of the required parameter names are found.
+  static bool shouldSkipByParams(
+    Map<String, String> parameters,
+    List<Map<String, String>> items,
+    List<String> requiredParamNames,
+  ) {
+    if (requiredParamNames.isEmpty) return false;
+    for (final paramName in requiredParamNames) {
+      if (parameters.containsKey(paramName)) return false;
+    }
+    for (final item in items) {
+      for (final paramName in requiredParamNames) {
+        if (item.containsKey(paramName)) return false;
+      }
+    }
+    return true;
+  }
+
   /// Check if an event should be skipped based on hide/show filters
   ///
   /// Returns true if the event should be skipped (not displayed)
